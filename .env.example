# ── Oracle Signal Service ──────────────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env.

# Set to "true" to enable on-chain transmission; "false" = simulation mode
ORACLE_ENABLED=false

# Blockchain (required only when ORACLE_ENABLED=true)
ETHEREUM_RPC=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
CHAIN_ID=1
ORACLE_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_DO_NOT_SHARE
GUARDIAN_CONTRACT=0xYOUR_GUARDIAN_CONTRACT_ADDRESS
DAO_CONTRACT=0xYOUR_DAO_CONTRACT_ADDRESS

# Database — sqlite works out of the box; use Postgres on Render/Supabase
DATABASE_URL=sqlite:///./oracle.db
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/oracle

# Redis job queue (optional; used by worker.py)
REDIS_URL=redis://localhost:6379/0

# Server
PORT=8000
DEBUG=false
